{
  "name": "@czlonkowski/n8n-nodes-librus",
  "version": "0.2.0",
  "description": "Dwa węzły n8n do pobierania wiadomości z Librus Synergia i uruchamiania automatyzacji po otrzymaniu nowych.",
  "license": "MIT",
  "keywords": [
    "n8n-community-node-package",
    "librus",
    "synergia"
  ],
  "author": {
    "name": "Romuald Członkowski",
    "email": "56956555+czlonkowski@users.noreply.github.com"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev --custom-user-folder ../.n8n-librus-dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "format": "prettier --write credentials nodes tests .github package.json tsconfig.json eslint.config.mjs",
    "test": "npm run build && node --test tests/*.test.cjs",
    "check": "npm run lint && npm test",
    "prepublishOnly": "npm run check",
    "prepack": "npm run build",
    "release": "node scripts/release.mjs"
  },
  "files": [
    "dist/nodes",
    "dist/credentials",
    "LICENSE",
    "NOTICE.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs/*.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/LibrusSessionApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Librus/Librus.node.js",
      "dist/nodes/Librus/LibrusTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.46.4",
    "@types/node": "24.3.0",
    "eslint": "9.32.0",
    "n8n-workflow": "2.38.1",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "tough-cookie": "6.0.2"
  },
  "homepage": "https://github.com/czlonkowski/n8n-nodes-librus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czlonkowski/n8n-nodes-librus.git"
  },
  "bugs": {
    "url": "https://github.com/czlonkowski/n8n-nodes-librus/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
